{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "TaskFlow — lightweight task management API for SIT753 7.3HD Jenkins DevOps pipeline",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "node scripts/build.js",
    "test": "jest --coverage --forceExit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "quality": "npm run lint && node scripts/quality-report.js",
    "security": "npm audit --audit-level=moderate || true",
    "security:strict": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 55,
        "functions": 75,
        "lines": 75,
        "statements": 75
      }
    }
  }
}
